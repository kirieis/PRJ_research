# ==========================================
# Project LUCY - Realtime Service Env Configuration
# ==========================================

# Server execution port
PORT=5000
NODE_ENV=development

# JWT HMAC Verification Key (Must match Dev 6 Auth Service config)
JWT_SECRET=CHANGE_ME_TO_A_32_PLUS_CHARACTER_SECRET_FOR_LUCY

# Microservices URLs
AUTH_SERVICE_URL=http://localhost:5000
CONTENT_API_URL=http://localhost:8081

# Redis Configuration (Week 8-9)
USE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379

# Agora RTC App Credentials (Week 1-2)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Agora Cloud Recording Credentials (Week 6-7)
AGORA_CUSTOMER_ID=your_agora_rest_api_customer_id
AGORA_CUSTOMER_CERTIFICATE=your_agora_rest_api_customer_certificate

# S3 Backup Storage for recordings
S3_VENDOR=1
S3_REGION=1
S3_BUCKET=your_s3_bucket_name
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key
